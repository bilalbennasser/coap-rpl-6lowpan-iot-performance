    org.contikios.cooja.plugins.ScriptRunner
    <plugin_config>
      <script>TIMEOUT(2280000, log.testOK());

while (true) {
  YIELD();

  if (msg.indexOf("TEMP_") &gt;= 0 ||
      msg.indexOf("TP07_END") &gt;= 0) {
    log.log(time + "\tID:" + id + "\t" + msg + "\n");
  }
}</script>
      <active>true</active>
    </plugin_config>
